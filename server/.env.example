# Supabase project URL (Settings -> API)
SUPABASE_URL=

# Supabase service-role key (Settings -> API -> service_role)
# IMPORTANT: The backend MUST use the service_role key, not the anon key,
# because it needs to insert/update incidents that are protected by RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Fallback: if SUPABASE_SERVICE_ROLE_KEY is not set, this is used instead.
# Only use the anon key if you have RLS policies that allow inserts.
SUPABASE_KEY=

# Server port and bind host
PORT=3000
HOST=0.0.0.0

# Allowed CORS origin(s), comma-separated
CLIENT_URL=http://localhost:5173
