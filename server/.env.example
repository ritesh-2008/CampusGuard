# ── Supabase ─────────────────────────────────────────────────────
# Project URL (Settings → API → URL)
SUPABASE_URL=

# Service-role key (Settings → API → service_role)
# Bypasses Row-Level Security — required for inserts/updates.
SUPABASE_SERVICE_ROLE_KEY=

# Admin client key (Settings → API → service_role)
# Used by supabaseAdmin for user management and privileged DB access.
SUPABASE_SECRET_KEY=

# Fallback: if SUPABASE_SERVICE_ROLE_KEY is not set, this is used instead.
# Only use the anon key if you have RLS policies that allow inserts.
SUPABASE_KEY=

# ── Auth & Admin ─────────────────────────────────────────────────
# Email of the designated admin user — only this email can update
# incident statuses via PATCH /api/incidents/:id/status.
ADMIN_EMAIL=

# ── Email (Resend) ──────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=

# ── Server ───────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# Allowed CORS origin(s), comma-separated.
CLIENT_URL=http://localhost:5173
